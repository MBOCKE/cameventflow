# ─────────────────────────────────────────────────────────────────────────────
#  CamEventFlow – Environment Variables
#  Copy this file to .env and fill in real values.
#  NEVER commit .env or .env.local to version control.
# ─────────────────────────────────────────────────────────────────────────────

# ── Database (Turso / libSQL) ─────────────────────────────────────────────────
#
#  CamEventFlow uses Turso (libSQL) for the database and Supabase for Auth
#  and Storage only.
#
#  TURSO_DATABASE_URL
#    Remote Turso DB : "libsql://<your-db-name>.turso.io"
#    Local file DB   : "file:./dev.db"   (no account needed for local dev)
#
#  TURSO_AUTH_TOKEN
#    Found in the Turso dashboard → your database → "Generate token"
#    Leave blank when using a local file:// URL.
#
#  How to get your credentials:
#    1. turso.tech → sign up (free tier: 500 DBs, 9 GB storage)
#    2. turso db create cameventflow
#    3. turso db show cameventflow           → copy the URL
#    4. turso db tokens create cameventflow  → copy the token
#
TURSO_DATABASE_URL="libsql://<your-db-name>.turso.io"
TURSO_AUTH_TOKEN="your-turso-auth-token"

# ── Supabase (Auth + Storage only – NOT used for the database) ────────────────
#
#  Supabase handles:
#    - Authentication  (lib/supabase.ts, middleware.ts)
#    - File Storage    (vendor-images bucket in vendor onboarding)
#
#  Get these from: supabase.com → your project → Settings → API
#
NEXT_PUBLIC_SUPABASE_URL="https://your-project-ref.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key"
# Server-only – NEVER expose to the browser
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

# ── Map (OpenStreetMap via react-leaflet) ─────────────────────────────────────
# No API key required. OpenStreetMap tiles are free and open.
# Respect the OSM Tile Usage Policy:
#   https://operations.osmfoundation.org/policies/tiles/
# Optional: override tile server URL in app/discover/LeafletMap.tsx for
# high-traffic production (e.g. maptiler.com free tier).
NEXT_PUBLIC_OSM_TILE_URL=""

# ── Venue Geocoding (BookingModal address search) ─────────────────────────────
# MapboxVenuePicker uses the Mapbox Geocoding REST API.
# Free alternative: replace with Nominatim in components/MapboxVenuePicker.tsx.
# Free token: https://account.mapbox.com/access-tokens/
NEXT_PUBLIC_MAPBOX_TOKEN=""

# ── TalkJS (In-app Messaging) ─────────────────────────────────────────────────
# App ID is public (browser SDK). Secret key is server-only.
# Get both from: https://talkjs.com/dashboard/
NEXT_PUBLIC_TALKJS_APP_ID=""
TALKJS_SECRET_KEY=""

# ── Make.com (Automated Notifications) ───────────────────────────────────────
# Outbound: CamEventFlow POSTs here after every new booking.
# Make.com → New Scenario → Webhooks → Custom Webhook → Copy URL
MAKE_WEBHOOK_URL=""

# Inbound: Make.com must send this as the X-Automate-Secret request header
# when calling POST /api/automate. Generate with: openssl rand -hex 32
AUTOMATE_WEBHOOK_SECRET=""

# ── App URL ───────────────────────────────────────────────────────────────────
# Used by metadataBase in app/layout.tsx for absolute OG/Twitter card URLs.
NEXT_PUBLIC_SITE_URL="https://cameventflow.vercel.app"

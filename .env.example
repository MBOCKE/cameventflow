# ─────────────────────────────────────────────────────────────────────────────
#  CamEventFlow – Environment Variables
#  Copy this file to .env.local and fill in real values.
#  Never commit .env.local to version control.
# ─────────────────────────────────────────────────────────────────────────────

# ── Database ──────────────────────────────────────────────────────────────────
# PostgreSQL connection string (used by Prisma)
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/cameventflow?schema=public"

# ── Supabase ──────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key"
# Service role key – SERVER ONLY, never expose to browser
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

# ── Map (OpenStreetMap via react-leaflet) ─────────────────────────────────────
# No API key required. OpenStreetMap tiles are free and open.
# The /discover page uses https://{s}.tile.openstreetmap.org tiles.
# Please respect the OSM Tile Usage Policy:
#   https://operations.osmfoundation.org/policies/tiles/
# For high-traffic production deployments consider a self-hosted tile server
# (e.g. maptiler.com free tier) and update the TileLayer url in
# app/discover/LeafletMap.tsx accordingly.
#
# NEXT_PUBLIC_OSM_TILE_URL is optional – leave blank to use the default OSM CDN.
NEXT_PUBLIC_OSM_TILE_URL=""

# ── Venue Geocoding (for BookingModal venue picker) ───────────────────────────
# MapboxVenuePicker still uses the Mapbox Geocoding REST API for address search.
# If you want to replace it with a free alternative (e.g. Nominatim / Photon),
# update components/MapboxVenuePicker.tsx and remove this variable.
# Get a free token at: https://account.mapbox.com/access-tokens/
NEXT_PUBLIC_MAPBOX_TOKEN=""

# ── TalkJS (In-app Messaging) ─────────────────────────────────────────────────
# App ID is public (used in browser SDK). Secret key is server-only.
# Get both from: https://talkjs.com/dashboard/
NEXT_PUBLIC_TALKJS_APP_ID=""
TALKJS_SECRET_KEY=""

# ── Make.com (Automated Notifications) ───────────────────────────────────────
# Outbound: URL of your Make.com scenario's Custom Webhook trigger.
# CamEventFlow POSTs to this URL after every new booking.
# Get it from: Make.com → New Scenario → Webhooks → Custom Webhook → Copy URL
MAKE_WEBHOOK_URL=""

# Inbound: secret header value Make.com must send when calling /api/automate.
# Set the same value in Make.com's HTTP module → Headers → x-automate-secret.
# Use any strong random string, e.g.: openssl rand -hex 32
AUTOMATE_WEBHOOK_SECRET=""

# ── App URL (used for OG / metadataBase in layout.tsx) ───────────────────────
NEXT_PUBLIC_SITE_URL="https://cameventflow.vercel.app"

// CamEventFlow – Prisma Schema
// Database : MySQL via XAMPP (local dev) → TiDB Cloud (production)
// Auth     : Supabase (unchanged)
// Storage  : Supabase (unchanged)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  // Local XAMPP:  mysql://root:@127.0.0.1:3306/cameventflow
  // TiDB Cloud:   mysql://<user>:<password>@<host>:4000/cameventflow?sslaccept=strict
  url      = env("DATABASE_URL")
}

// ─────────────────────────────────────────────────────────────────────────────
// Models
// MySQL supports native ENUM; we keep String fields with valid-value comments
// so switching to TiDB Cloud (MySQL-compatible) requires zero schema changes.
// ─────────────────────────────────────────────────────────────────────────────

model User {
  id         String   @id @default(cuid())
  supabaseId String   @unique
  email      String   @unique
  phone      String?
  name       String
  // Valid values: "PLANNER" | "VENDOR"
  role       String   @default("PLANNER")
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  // Relations
  vendor   Vendor?   // A VENDOR user has one vendor profile
  bookings Booking[] // A PLANNER user has many bookings (as planner)

  @@map("users")
}

model Vendor {
  id              String   @id @default(cuid())
  userId          String   @unique
  // Valid values: "Venue" | "Caterer" | "Decorator" | "Sound" | "Photographer"
  category        String
  // Valid values: "Douala" | "Yaounde" | "Buea"
  city            String
  basePrice       Float
  availability    Boolean  @default(true)
  // TEXT used for description so MySQL's 191-char index limit on VARCHAR
  // does not cause issues on utf8mb4 collations
  description     String   @db.Text
  profileImageUrl String?

  // ── Event discovery fields ──────────────────────────────────────────────
  isEvent        Boolean   @default(false)
  latitude       Float?
  longitude      Float?
  eventStartTime DateTime?
  eventEndTime   DateTime?
  // Valid values: "LIVE" | "UPCOMING" | "ENDED"
  activeStatus   String    @default("UPCOMING")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  bookings Booking[]

  @@map("vendors")
}

model Booking {
  id         String   @id @default(cuid())
  plannerId  String
  vendorId   String
  eventDate  DateTime
  guestCount Int
  // Valid values: "PENDING" | "CONFIRMED" | "CANCELED"
  status     String   @default("PENDING")
  message    String   @db.Text
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  // Relations
  planner User   @relation(fields: [plannerId], references: [id], onDelete: Cascade)
  vendor  Vendor @relation(fields: [vendorId], references: [id], onDelete: Cascade)

  @@map("bookings")
}

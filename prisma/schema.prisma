// CamEventFlow – Prisma Schema
// PostgreSQL + Supabase

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DATABASE_URL")
}

// ─────────────────────────────────────────────
// Enums
// ─────────────────────────────────────────────

enum Role {
  PLANNER
  VENDOR
}

enum VendorCategory {
  Venue
  Caterer
  Decorator
  Sound
  Photographer
}

enum City {
  Douala
  Yaounde
  Buea
}

enum BookingStatus {
  PENDING
  CONFIRMED
  CANCELED
}

enum ActiveStatus {
  LIVE
  UPCOMING
  ENDED
}

// ─────────────────────────────────────────────
// Models
// ─────────────────────────────────────────────

model User {
  id          String   @id @default(cuid())
  supabaseId  String   @unique
  email       String   @unique
  phone       String?
  name        String
  role        Role     @default(PLANNER)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  vendor      Vendor?           // A VENDOR user has one vendor profile
  bookings    Booking[]         // A PLANNER user has many bookings (as planner)

  @@map("users")
}

model Vendor {
  id              String         @id @default(cuid())
  userId          String         @unique
  category        VendorCategory
  city            City
  basePrice       Float
  availability    Boolean        @default(true)
  description     String
  profileImageUrl String?

  // ── Event discovery fields (added Day 2) ──────────────────────────
  isEvent        Boolean      @default(false)  // true = this entry is a live/upcoming event
  latitude       Float?                        // GPS latitude  (required when isEvent = true)
  longitude      Float?                        // GPS longitude (required when isEvent = true)
  eventStartTime DateTime?                     // Nullable – only for events
  eventEndTime   DateTime?                     // Nullable – only for events
  activeStatus   ActiveStatus @default(UPCOMING)

  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  // Relations
  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  bookings Booking[] // A vendor can have many bookings

  @@map("vendors")
}

model Booking {
  id          String        @id @default(cuid())
  plannerId   String
  vendorId    String
  eventDate   DateTime
  guestCount  Int
  status      BookingStatus @default(PENDING)
  message     String
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  // Relations
  planner User   @relation(fields: [plannerId], references: [id], onDelete: Cascade)
  vendor  Vendor @relation(fields: [vendorId], references: [id], onDelete: Cascade)

  @@map("bookings")
}

{
  "version": "v1",
  "hooks": [
    {
      "name": "Lint on Save",
      "trigger": "PostFileSave",
      "description": "Runs Next.js ESLint on any saved TypeScript file and surfaces errors inline.",
      "matcher": "\\.(ts|tsx)$",
      "action": {
        "type": "command",
        "command": "cd \"$(dirname \"$0\")\" && npx next lint --file \"${KIRO_FILE_PATH}\" --quiet 2>&1 | head -30"
      }
    }
  ]
}